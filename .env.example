# Supabase client values for the browser build
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase server-only values. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# App URL used by server-side links and callbacks
APP_URL="http://localhost:3000"

# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Maps
NOMINATIM_BASE_URL="https://nominatim.your-domain.com"
VITE_NOMINATIM_BASE_URL="https://nominatim.your-domain.com"
MAP_STYLE_URL="https://tiles.your-domain.com/styles/basic/style.json"
VITE_MAP_STYLE_URL="https://tiles.your-domain.com/styles/basic/style.json"

# Media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_FOLDER="tripetrip"

# Email
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Tripetrip <hello@tripetrip.com>"

# Optional AI provider
GEMINI_API_KEY="your-gemini-api-key"
